{
  "name": "bancodedadospioli",
  "version": "1.0.0",
  "description": "Backend database system with webhook listeners, REST API, and visual frontend for health plan data management",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"node server/index.js\" \"cd client && npm run dev\"",
    "server": "node server/index.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "build": "cd client && npm run build",
    "start": "NODE_ENV=production node server/index.js",
    "seed": "node server/utils/seed.js",
    "convert-xlsx": "node server/utils/xlsx-to-xml.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fast-xml-parser": "^4.5.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
